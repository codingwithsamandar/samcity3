# ═══════════════════════════════════════════════════════════════════
#  SamCity — root .gitignore (Django backend + Flutter mobil ilova)
# ═══════════════════════════════════════════════════════════════════

# ── Python / virtualenv ──────────────────────────────────────────
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# ── Django ───────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.log
logs/
staticfiles/
/static_collected/
media/
local_settings.py

# ── Maxfiy: muhit o'zgaruvchilari (.env.example saqlanadi) ────────
.env
.env.*
!.env.example

# ── Flutter / Dart ───────────────────────────────────────────────
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/pubspec.lock
mobile/**/generated_plugin_registrant.*
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Pods/
mobile/android/.gradle/
mobile/android/captures/
mobile/android/key.properties
mobile/android/app/upload-keystore.jks
mobile/**/*.iml

# ── IDE / muharrirlar ────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*~

# ── OS fayllari ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Docker / deploy lokal ────────────────────────────────────────
*.pid
docker-compose.override.yml
# Sertifikatlar: .pem fayllar maxfiy, lekin papka + hujjat saqlanadi
certs/*
!certs/README.md
!certs/.gitkeep

# ── Claude Code lokal sozlamalari va worktree'lar (shaxsiy, GitHub'ga kerak emas) ──
.claude/

# ── settings.py zaxira nusxasi ──
sdev/settings_old.py

# ── Katta binar fayllar: GitHub'ga ham, Docker image'ga ham kerak emas ──
# APK (~61MB) va zip arxivlar deploy'ni sekinlashtiradi va GitHub'ning 100MB
# chekloviga yaqinlashtiradi. Kerak bo'lsa GitHub Releases orqali tarqating.
*.apk
*.zip
# ISTISNO: bu arxiv `manage.py import_catalog` uchun MAJBURIY manba —
# entrypoint.sh baza bo'sh bo'lganda undan katalog rasmlarini oladi.
# Ignore qilinsa Render'da katalog rasmsiz qoladi.
!New/catalog_images.zip

# ── Vaqtinchalik/tasodifiy yuklangan fayllar ──
fayl.pdf
samcity_home.html

# ── jarvis/ — alohida desktop loyiha, o'z .git'i bor (SamCity saytiga aloqasi yo'q) ──
# Ilgari .gitmodules'siz submodule (gitlink) sifatida yozilgan edi — repo klon
# qilinganda bo'sh papka bo'lib qolardi. Endi butunlay ignore qilinadi.
jarvis/

# Generated catalog export (manage.py export_catalog)
catalog_export.json

# Dizayn kanvasi — generatsiya qilinadigan fayl (manba: design/*.dc.html + canvas.json)
design/shahar-ilova-prototipi.html
