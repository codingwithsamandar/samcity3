# ═══════════════════════════════════════════════════════════════════
#  SamCity — muhit o'zgaruvchilari namunasi
#  Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring.
#  ⚠️ Haqiqiy `.env` ni HECH QACHON git'ga qo'shmang (.gitignore'da bor).
#
#  MAJBURIY (production): DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS,
#     CSRF_TRUSTED_ORIGINS, baza (DATABASE_URL yoki POSTGRES_*).
#  OTP uchun: SMS_* (asosiy kanal) YOKI TELEGRAM_BOT_TOKEN (demo/dev kanal).
#  IXTIYORIY: REDIS_URL, PAYME_*/CLICK_*, AWS_*/CLOUDINARY_*, SENTRY_DSN,
#     DJANGO_SUPERUSER_*.
# ═══════════════════════════════════════════════════════════════════

# ── Django asosiy ────────────────────────────────────────────────
# Xavfsiz kalit yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE-ME-uzun-tasodifiy-kalit
# Kod default'i ham False — lokal ishlaganda True qiling.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.uz,www.yourdomain.uz
CSRF_TRUSTED_ORIGINS=https://yourdomain.uz,https://www.yourdomain.uz

# ── Android APK ──────────────────────────────────────────────────
# APK fayli repoga tushmaydi (.gitignore: *.apk), shuning uchun serverda
# yuklab olish ishlashi uchun faylni tashqarida saqlab, manzilini yozing
# (GitHub Releases eng oson va bepul yo'l):
#   APK_DOWNLOAD_URL=https://github.com/<user>/<repo>/releases/download/v1.0.0/samcity.apk
# Bo'sh bo'lsa: diskda fayl bo'lsa o'sha beriladi, bo'lmasa tugma yashiriladi.
APK_DOWNLOAD_URL=

# ── Ma'lumotlar bazasi ───────────────────────────────────────────
# Ustuvorlik: DATABASE_URL > POSTGRES_* > SQLite (dev). Bittasini tanlang.
#
# (A) Yagona ulanish satri (Render/Heroku ko'pincha shuni beradi):
# DATABASE_URL=postgres://user:parol@host:5432/dbname
#
# (B) Yoki alohida maydonlar (docker-compose / Render Blueprint fromDatabase):
POSTGRES_DB=samcity
POSTGRES_USER=samcity
POSTGRES_PASSWORD=CHANGE-ME-db-parol
POSTGRES_HOST=db          # docker-compose'da xizmat nomi
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60
#
# Ikkalasi ham bo'sh bo'lsa — SQLite (faqat dev; production'da ISHLATMANG).

# ── Redis (channel layer + cache; ixtiyoriy) ─────────────────────
# Bo'sh qolsa: in-memory channel layer + locmem cache (bitta instansiya).
REDIS_URL=redis://redis:6379/0

# ── Admin superuser (entrypoint.sh avtomatik yaratadi; ixtiyoriy) ─
# Render'da Shell yo'q — shu ikki qiymat bilan admin avtomatik yaratiladi.
DJANGO_SUPERUSER_PHONE=
DJANGO_SUPERUSER_PASSWORD=

# ── CORS (mobil/web klient uchun) ────────────────────────────────
# Bo'sh qoldirsangiz: DEBUG=True'da hammaga ruxsat, False'da yopiq.
CORS_ALLOWED_ORIGINS=https://yourdomain.uz

# ── Xavfsizlik (DEBUG=False bo'lganda kuchga kiradi) ──────────────
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ── JWT (mobil) ──────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# ── To'lov shlyuzlari (Payme / Click) ────────────────────────────
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# ── SMS shlyuzi ──────────────────────────────────────────────────
# SMS_BACKEND: eskiz | playmobile | console (default dev'da console)
SMS_BACKEND=eskiz
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_ESKIZ_FROM=4546
SMS_PLAYMOBILE_LOGIN=
SMS_PLAYMOBILE_PASSWORD=
SMS_PLAYMOBILE_FROM=3700

# ── Telegram OTP boti (demo/dev — SMS o'rniga Telegram orqali kod) ──
# @BotFather'dan token oling (/newbot). Bo'sh qolsa — Telegram kanali o'chiq
# bo'ladi va OTP mavjud SMS backend orqali ketaveradi (xato bermaydi).
TELEGRAM_BOT_TOKEN=
# Ixtiyoriy: deep-link (t.me/<username>) uchun; berilmasa getMe orqali topiladi.
TELEGRAM_BOT_USERNAME=
# Telegram OTP'ni yoqish (default: DEBUG). Production'da False qoldiring.
TELEGRAM_OTP_ENABLED=False

# ── FCM push (ixtiyoriy — bo'sh bo'lsa o'chiq) ────────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key.
# JSON faylni serverga qo'ying va to'liq yo'lini yozing. Yo'riqnoma: FCM_SETUP.md
FIREBASE_CREDENTIALS_FILE=

# ── Monitoring (ixtiyoriy — bo'sh bo'lsa o'chiq) ──────────────────
SENTRY_DSN=

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# ── Media storage (Render free plan — disk saqlanmaydi!) ─────────
# Cloudinary (tavsiya): https://cloudinary.com — bepul rejada yetarli
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Yoki AWS S3 (Cloudinary o'rniga):
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=

# ── Taksi moduli (ARXIVLANGAN) ────────────────────────────────────
# Bo'sh/False = taksi foydalanuvchiga BUTUNLAY yopiq: /taxi/ sahifalari,
# /api/taxi/... endpointlari, ws/taxi/... socketlari ulanmaydi; navbar va
# asosiy sahifadagi havolalar, PWA yorlig'i, xaritadagi taksistlar va AI
# yordamchidagi taksi buyurtma tool'i ko'rinmaydi. Kod va baza jadvallari
# joyida qoladi. Mobil ilova uchun ham alohida yoqish kerak:
#   flutter build apk --release --dart-define=TAXI_ENABLED=true
TAXI_ENABLED=False

# To'lovlar bo'limi (/payments/) — vaqtincha yopiq.
# False: sahifalarga kirib bo'lmaydi, menyudagi havolalar yashiriladi.
# DIQQAT: Payme/Click webhook'lari bu bayroqdan mustaqil — har doim ishlaydi.
PAYMENTS_ENABLED=False

# Hokim paneli (/hokim/) — mahalla bo'limi bilan birga arxivlangan.
HOKIM_ENABLED=False

# ── Ko'p tillilik (ARXIVLANGAN) ───────────────────────────────────
# Bo'sh/False = sayt faqat o'zbek tilida; til almashtirgich yashirin,
# ru/en ga o'tib bo'lmaydi. locale/ru va locale/en tarjimalari joyida
# qoladi — True qilsangiz uchala til qaytadi.
MULTILANG_ENABLED=False

# ── Yo'nalish (routing) dvigateli ─────────────────────────────────
# Xaritadagi marshrut, masofa va ETA shu OSRM serveridan olinadi
# (places/views.py: route_api). Default — ommaviy demo server: bepul,
# kalit talab qilmaydi, LEKIN kafolatsiz va og'ir yuk uchun mo'ljallanmagan.
# Productionda o'z OSRM'ingizni ko'taring (Uzbekistan OSM extract) va shu
# yerda manzilini ko'rsating:
#   OSRM_BASE=http://osrm:5000
OSRM_BASE=https://router.project-osrm.org

# ─── Xarita plitkalari ───────────────────────────────────────────────────────
# osm      — kalitsiz ishlaydi (OpenStreetMap, ODbL). Ko'cha nomlari bor,
#            lekin O'zbekistonda bino/ichki ko'cha ma'lumoti kam.
# maptiler — https://cloud.maptiler.com dan bepul kalit oling. Sputnik +
#            ko'cha nomlari ("hybrid") — eng yaxshi ko'rinish.
# mapbox   — https://account.mapbox.com dan token. satellite-streets uslubi.
# yandex   — DEFAULT, eng sifatli. DIQQAT: rasmiy litsenziyasiz —
#            bloklanish/huquqiy xavf bor. Ishlab chiqarishga chiqishdan
#            oldin quyidagilardan biriga o'tish tavsiya etiladi.
MAP_TILE_PROVIDER=yandex
MAP_TILE_KEY=
